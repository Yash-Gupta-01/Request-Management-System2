@model IEnumerable<RMS.Models.RequestDetails>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-gray-900">Active Requests</h1>
            <p class="mt-2 text-sm text-gray-700">A list of all active requests from all users that need your attention.</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <a href="@Url.Action("CompletedRequests", "Admin")" 
               class="block rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                View Completed Requests
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center mt-8">
            <p class="text-gray-500">No active requests found.</p>
        </div>
    }
    else
    {
        <div class="mt-8 flow-root">
            <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                    <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                        <table class="min-w-full divide-y divide-gray-300">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Request ID</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Details</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Requester</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">@request.RequestNumber</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@request.RequestType</td>
                                    <td class="px-3 py-4 text-sm text-gray-500 max-w-md truncate">@request.Subject</td>
                                </tr>
                                <tr>
                                    <td colspan="7" class="px-3 py-4 text-sm text-gray-500 max-w-md truncate">@request.Details</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@request.User.FullName</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@request.DateOfIssue.ToLocalTime().ToString("g")</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm">
                                            <span class="@(request.CurrentStatus switch {
                                                "Yet to Start" => "inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10",
                                                "In Progress" => "inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10",
                                                "About to Finish" => "inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20",
                                                _ => "inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10"
                                            })">
                                                @request.CurrentStatus
                                            </span>
                                        </td>
                                        <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                            <a href="@Url.Action("Details", "Admin", new { id = request.RequestId })" 
                                               class="text-indigo-600 hover:text-indigo-900">Update Status</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
