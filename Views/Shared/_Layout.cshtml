<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RMS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full">
    <header class="bg-white shadow">
        <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 justify-between">
                <div class="flex">
                    <a href="@Url.Action("Index", "Home")" class="flex items-center">
                        <span class="text-lg font-semibold text-gray-900">Request Management System</span>
                    </a>
                </div>

                <div class="flex items-center gap-x-8">
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="AdminHome" 
                           class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                            Active Requests
                        </a>
                        <a asp-controller="Admin" asp-action="CompletedRequests"
                           class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                            Completed Requests
                        </a>
                    }
                    else if (Context.Session.GetString("Role") == "Guest")
                    {
                        <a asp-controller="Request" asp-action="GuestHome"
                           class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                            Dashboard
                        </a>
                        <a asp-controller="Request" asp-action="ActiveRequests"
                           class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                            Active Requests
                        </a>
                        <a asp-controller="Request" asp-action="OldRequests"
                           class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                            Old Requests
                        </a>
                    }
                    @if (Context.Session.GetString("Username") != null)
                    {
                        <div class="flex items-center gap-x-4">
                            <span class="text-sm text-gray-500">Welcome, @Context.Session.GetString("Username")</span>
                            <a asp-controller="User" asp-action="Logout"
                               class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                                Logout
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-x-4">
                            <a asp-controller="User" asp-action="Login"
                               class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600">
                                Login
                            </a>
                            <a asp-controller="User" asp-action="Register"
                               class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                                Register
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        @RenderBody()
    </main>

    <footer class="fixed bottom-0 w-full bg-white shadow">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <p class="text-center text-sm text-gray-500">
                &copy; 2025 - Request Management System
            </p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
